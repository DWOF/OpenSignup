# Easebourne branding for OpenSignup.
# apply.sh reads this file. After changing a value, run make-assets.py
# (only needed if you change the colours or names), commit, then on the
# server run apply.sh and rebuild.

# Name shown in page headers, emails and the browser tab.
BRAND_NAME="Easebourne Scouts & Guides"

# Strapline on the link preview image (WhatsApp, email, Facebook).
BRAND_TAGLINE="Fundraising and helper sign-ups"
BRAND_SECTIONS="Rainbows  ·  Brownies  ·  Guides  ·  Beavers  ·  Cubs  ·  Scouts"

# Letter(s) on the browser tab icon.
BRAND_MONOGRAM="E"

# Main colour (buttons, links, focus rings, icon).
# Poppy red for the Remembrance appeal. Alternatives:
#   Scouts purple  #7413dc
#   Girlguiding navy  #161b4e
BRAND_COLOR="#c8102e"
# Darker shade for button hover.
BRAND_COLOR_DARK="#9e0c24"
# Very light tint for selected and highlighted backgrounds.
BRAND_COLOR_SOFT="#fbe3e7"
